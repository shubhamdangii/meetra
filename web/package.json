{
  "name": "meetra-web",
  "version": "2.0.0",
  "private": true,
  "description": "meetra: hosted meetups for people coming solo (Next.js static site for GitHub Pages)",
  "scripts": {
    "dev": "node scripts/images-manifest.mjs && next dev -p 3000",
    "build": "node scripts/images-manifest.mjs && node scripts/game-covers.mjs && next build && node scripts/fix-export.mjs",
    "start": "npx serve@14.2.4 out -l 3000",
    "typecheck": "tsc --noEmit",
    "test:db": "node tests/db/roles.test.mjs",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "qa": "node tests/qa/run-qa.mjs",
    "qa:seed": "node tests/seed/seed.mjs",
    "qa:reset": "node tests/seed/seed.mjs --reset-only",
    "qa:build": "node tests/qa/build-test-site.mjs",
    "qa:roles": "node tests/seed/verify-roles.mjs",
    "qa:config": "node tests/qa/config-default.test.mjs",
    "qa:test": "playwright test -c playwright.qa.config.ts",
    "qa:report": "node tests/qa/report.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "framer-motion": "14.10.1",
    "jsqr": "1.4.0",
    "next": "16.4.5",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pg": "^8.13.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
